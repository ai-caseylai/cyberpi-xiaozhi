# CyberPi sdkconfig — 最大化資源設定
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# CPU — 全速 240MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# WiFi
CONFIG_ESP_WIFI_SSID="SmarTone_HBB_3A74"
CONFIG_ESP_WIFI_PASSWORD="6J25GJ2GB5"
CONFIG_ESP_MAXIMUM_RETRY=5

# SPI Display (ST7735)
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# I2S Audio
CONFIG_I2S_ISR_IN_IRAM=y

# HTTP
CONFIG_ESP_HTTP_CLIENT_ENABLE=y

# Flash — 4MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Optimization — 最大效能 (-O2)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# Heap — 不校驗，最大化可用 RAM
CONFIG_HEAP_POISONING_DISABLED=y
